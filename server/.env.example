# Server Configuration
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/saferoute?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# OpenRouter / Gemini LLM (Optional - fallback available)
OPENROUTER_API_KEY=your_openrouter_api_key

# Twilio SMS Service (Optional - fallback to simulation)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Python ML Microservice URL
ML_SERVICE_URL=http://localhost:5001
